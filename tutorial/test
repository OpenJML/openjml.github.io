#! /bin/bash

J=`(cd ../../OpenJML/OpenJMLsrc; pwd)`
PATH=$J:$PATH
X=0 

## Each example, .check script and exercise is stopped after $TIMEOUT seconds (default 300)
## and then reported as a failure.
TIMEOUT=${TIMEOUT:-300}
## Runs the command in its own process group; after $TIMEOUT seconds stops the whole group
## (so also the java and solver processes it started) and exits with 124.
run_with_timeout() {
  perl -e '
    my $t = shift;
    my $pid = fork;
    if ($pid == 0) { setpgrp(0, 0); exec @ARGV; exit 127; }
    local $SIG{ALRM} = sub { kill "TERM", -$pid; sleep 2; kill "KILL", -$pid; waitpid($pid, 0); exit 124; };
    alarm $t;
    waitpid($pid, 0);
    exit(($? & 127) ? 128 + ($? & 127) : $? >> 8);
  ' "$TIMEOUT" "$@"
}
## Temporary logs are removed even if the run is interrupted
trap 'rm -f "$log" "$logt" "$logx"' EXIT
## './test --exercises' checks only the exercises
if [ "$1" = "--exercises" ]; then EXERCISES_ONLY=1; shift; fi
files="$@"
if [ -n "$EXERCISES_ONLY" ]; then files=""; elif [ -z "$files" ]; then files=`ls *.java *.check` ; fi
for f in $files ; do
  logt=$(mktemp logtXXXXXXXX )
  log=$(mktemp logXXXXXXXX )
  h=`echo $f | sed -e 's/java/check/'`;
  if [ -e $h -a "$f" != "$h" ]; then continue; fi
  if [ -e $h ]; then
    echo $f
    run_with_timeout bash $f; e=$?
    if [ $e -eq 124 ]; then X=1; echo "TIMEOUT after $TIMEOUT s: " $f; elif [ $e -ne 0 ]; then X=1; fi
    continue
  fi
  o=`echo $f | sed -e 's/java/out/'`;
  c=`cat $f | head -1 | sed -e 'sx//[ ]*xx' | sed -e s/\\$@/$f/ | grep -v '##'`
  if [ "$c" != "" ]; then 
    echo EXEC "$c"
    run_with_timeout bash -c "$c --specs-path ../../Specs/specs" > $logt  2>&1
    e=$?
    if [ $e -eq 124 ]; then X=1; echo "TIMEOUT after $TIMEOUT s: " $f; rm -rf $log $logt; continue; fi
    grep -v "Note:" $logt > $log
    if [ -e $o ]; then 
	if [ $e -eq "0" ]; then 
	    if [ "$f" != "T_PureMethod1.java" ]; then X=1; echo $f "has out file but exit code of 0"; fi; ## Special case of all warnings so 0 exit code
	fi 
	cat $log | sed -e 's/[0-9][0-9.]* secs/TTTT secs/' | sed -e 's/DURATION:[ ]*TTTT/DURATION:          TTTT/' | tee $o.actual | cmp -s - $o ; z=$? ;
	if [ $z -ne "0" ]; then 
	    n=1
	    while [ -e $o$n ]; do
		cmp -s $o.actual $o$n && z=$? && break
		(( n++ ))
            done
	    if [ $z -ne 0 ]; then
		diff $o.actual $o
	        X=1; echo $f "has wrong output" ;
	    else
		rm $o.actual
	    fi
        else
            rm $o.actual
	fi 
    elif [ -n "$( cat $log )" ]; then 
	echo "OK example has output: " $f 
	cat $log 
    elif [ $e -ne "0" ]; then 
	X=1; echo "OK example has unexpected exit code: " $f $e 
    fi ; 
  else
    echo "Skipping non-deterministic test " $f ;
  fi ;
  rm -rf $log $logt
done 

if [ -z "$1" ]; then
echo CHECKING EXERCISES
cd exercises
for f in *.java ; do 
  logx=$(mktemp "$PWD/logxXXXXXXXX")
  echo Checking $f
  h=`echo $f | sed -e 's/java/out/'`
  ## OpenJML's 'Not implemented' notes (each with its two continuation lines) are left out:
  ## they name files by absolute path
  run_with_timeout openjml --esc $f | awk '/: Note: /{skip=2; next} skip>0{skip--; next} {print}' > $logx
  E=${PIPESTATUS[0]}
  if [ $E -eq 124 ]; then
    X=1; echo "TIMEOUT after $TIMEOUT s - $f FAILED"
  elif [ -e "$h" ]; then 
    diff $logx $h || { X=1; echo $f FAILED; mv $logx $f.actual; }
  elif [ "$E" != "0" ]; then
    X=1; echo "Exit code $E - $f FAILED" ; mv $logx $f.actual
  fi
  rm -rf $logx
done
cd ..
fi
rm -rf log*
if [ "$X" = "0" ]; then echo Tutorial tests successful; else echo Tutorial tests FAILED ; fi
exit $X 

